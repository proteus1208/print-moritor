<Window x:Class="PrintArchive.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrintArchive.UI.Controls"
        Title="PrintArchive History" Height="820" Width="1220"
        MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Closing="Window_Closing">
  <Grid>
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="160"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Print history" FontSize="24" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="UsageText" VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{StaticResource MutedBrush}"/>
          <Button Content="Refresh" Click="Refresh_Click"/>
          <Button Content="Lock" Click="Lock_Click"/>
          <Button Content="Settings" Click="Settings_Click"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Grid.Column="0"
                   ToolTip="Search by document or user"
                   TextChanged="FilterChanged"/>
          <ComboBox x:Name="PrinterFilter" Grid.Column="2"
                    SelectionChanged="FilterChanged"/>
          <Button Grid.Column="4" Content="◀" Width="36" Click="PrevDay_Click"/>
          <DatePicker x:Name="DayPicker" Grid.Column="6" Width="150"
                      SelectedDateChanged="DayChanged"/>
          <Button Grid.Column="8" Content="▶" Width="36" Click="NextDay_Click"/>
          <Button Grid.Column="10" Content="Today" Click="Today_Click"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="TimelineHeader" FontWeight="SemiBold" Margin="0,0,0,6"
                     Text="Timeline (0:00 – 24:00)"/>
          <controls:DayTimeline x:Name="Timeline"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
              CornerRadius="8" ClipToBounds="True">
        <DataGrid x:Name="JobsGrid"
                  Margin="1"
                  Background="{StaticResource PanelBrush}"
                  MouseDoubleClick="JobsGrid_MouseDoubleClick"
                  SelectionChanged="JobsGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Time"
                                Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}"
                                Width="90" ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" Width="*"
                                ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Outcome" Binding="{Binding PrintOutcome}" Width="90"
                                ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Duration" Binding="{Binding DurationLabel}" Width="80"
                                ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Repeats" Binding="{Binding RepeatLabel}" Width="70"
                                ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="160"
                                ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="60"
                                ElementStyle="{StaticResource ColumnText}"/>
            <DataGridTextColumn Header="Capture" Binding="{Binding CaptureStatus}" Width="180"
                                ElementStyle="{StaticResource ColumnText}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Details + screenshot preview (bottom-left) -->
      <Border Grid.Row="4" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12" Margin="0,12,0,0" Height="160">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                  BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                  Cursor="Hand" MouseLeftButtonDown="ScreenshotPreview_Click"
                  ToolTip="Click to view fullscreen">
            <Grid>
              <TextBlock x:Name="ScreenshotPlaceholder" Text="No screenshot"
                         Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image x:Name="ScreenshotPreview" Stretch="Uniform" Margin="4"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold"
                         Text="Select a print job" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailBody" Margin="0,6,0,0"
                         Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap"
                         Text="Double-click a row to open the archived original file."/>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Content="Open" Style="{StaticResource PrimaryButton}" Click="Open_Click"/>
            <Button Content="Export..." Click="Export_Click"/>
            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Fullscreen screenshot overlay -->
    <Border x:Name="FullscreenOverlay" Background="#F2000000" Visibility="Collapsed"
            MouseLeftButtonDown="FullscreenOverlay_Click" Cursor="Hand"
            Panel.ZIndex="100">
      <Image x:Name="FullscreenImage" Stretch="Uniform" Margin="24"
             IsHitTestVisible="False"/>
    </Border>
  </Grid>
</Window>
