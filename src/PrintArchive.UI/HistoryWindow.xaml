<Window x:Class="PrintArchive.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintArchive History" Height="740" Width="1200"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Closing="Window_Closing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="180"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Print history" FontSize="24" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock x:Name="UsageText" VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{StaticResource MutedBrush}"/>
        <Button Content="Refresh" Click="Refresh_Click"/>
        <Button Content="Lock" Click="Lock_Click"/>
        <Button Content="Settings" Click="Settings_Click"/>
      </StackPanel>
    </Grid>

    <!-- Filters -->
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0"
                 ToolTip="Search by document or user"
                 TextChanged="FilterChanged"/>
        <ComboBox x:Name="PrinterFilter" Grid.Column="2"
                  SelectionChanged="FilterChanged"/>
        <DatePicker x:Name="FromDate" Grid.Column="4" Width="140"
                    SelectedDateChanged="FilterChanged"/>
        <TextBlock Grid.Column="5" Text="-" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"/>
        <DatePicker x:Name="ToDate" Grid.Column="6" Width="140"
                    SelectedDateChanged="FilterChanged"/>
        <Button Grid.Column="8" Content="Clear" Click="ClearFilters_Click"/>
      </Grid>
    </Border>

    <!-- Job table (scrolls inside DataGrid) -->
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True">
      <DataGrid x:Name="JobsGrid"
                Margin="1"
                Background="{StaticResource PanelBrush}"
                MouseDoubleClick="JobsGrid_MouseDoubleClick"
                SelectionChanged="JobsGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time"
                              Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                              Width="150"
                              ElementStyle="{StaticResource ColumnText}"/>
          <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" Width="*"
                              ElementStyle="{StaticResource ColumnText}"/>
          <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="140"
                              ElementStyle="{StaticResource ColumnText}"/>
          <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="180"
                              ElementStyle="{StaticResource ColumnText}"/>
          <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="70"
                              ElementStyle="{StaticResource ColumnText}"/>
          <DataGridTextColumn Header="Status" Binding="{Binding CaptureStatus}" Width="220"
                              ElementStyle="{StaticResource ColumnText}"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Details -->
    <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14" Margin="0,12,0,0" MaxHeight="160">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold"
                       Text="Select a print job" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailBody" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="Double-click a row to decrypt and open the archived document when available."/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Open" Style="{StaticResource PrimaryButton}" Click="Open_Click"/>
          <Button Content="Export..." Click="Export_Click"/>
          <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
