<Window x:Class="PrintArchive.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintArchive History" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <DockPanel Margin="18">
    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <TextBlock x:Name="UsageText" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{StaticResource MutedBrush}"/>
        <Button Content="Refresh" Click="Refresh_Click"/>
        <Button Content="Settings" Click="Settings_Click"/>
      </StackPanel>
      <TextBlock Text="Print history" FontSize="26" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Filters -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0"
                 ToolTip="Search by document or user"
                 TextChanged="FilterChanged"/>
        <ComboBox x:Name="PrinterFilter" Grid.Column="2"
                  SelectionChanged="FilterChanged"/>
        <DatePicker x:Name="FromDate" Grid.Column="4" Width="140"
                    SelectedDateChanged="FilterChanged"/>
        <TextBlock Grid.Column="5" Text="–" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"/>
        <DatePicker x:Name="ToDate" Grid.Column="6" Width="140"
                    SelectedDateChanged="FilterChanged"/>
        <Button Grid.Column="8" Content="Clear" Click="ClearFilters_Click"/>
      </Grid>
    </Border>

    <!-- Details + actions -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Open" Style="{StaticResource PrimaryButton}" Click="Open_Click"/>
          <Button Content="Export…" Click="Export_Click"/>
          <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold"
                     Text="Select a print job"/>
          <TextBlock x:Name="DetailBody" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap"
                     Text="Double-click a row to decrypt and open the archived document when available."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Grid -->
    <DataGrid x:Name="JobsGrid"
              MouseDoubleClick="JobsGrid_MouseDoubleClick"
              SelectionChanged="JobsGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="150"/>
        <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" Width="*"/>
        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="140"/>
        <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="180"/>
        <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="70"/>
        <DataGridTextColumn Header="Status" Binding="{Binding CaptureStatus}" Width="220"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
