<Window x:Class="PrintArchive.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintArchive" Height="460" Width="460"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="0">
    <Border Background="{StaticResource PanelBrush}" Margin="20" CornerRadius="12"
            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" Padding="28">
      <StackPanel>
        <TextBlock Text="PrintArchive" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="Subtitle" Margin="0,10,0,22"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Enter your archive password to unlock print history."/>

        <TextBlock x:Name="PasswordLabel" Text="Password" Margin="0,0,0,6"
                   Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="PasswordInput" Height="40" VerticalContentAlignment="Center"/>

        <StackPanel x:Name="ConfirmPanel" Margin="0,16,0,0" Visibility="Collapsed">
          <TextBlock Text="Confirm password" Margin="0,0,0,6"
                     Foreground="{StaticResource MutedBrush}"/>
          <PasswordBox x:Name="ConfirmInput" Height="40" VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Margin="0,14,0,0" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
          <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
          <Button x:Name="PrimaryButton" Content="Unlock" Style="{StaticResource PrimaryButton}"
                  IsDefault="True" Click="Primary_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
