<Window x:Class="PrintArchive.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintArchive" Height="360" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Border Background="{StaticResource PanelBrush}" Margin="18" CornerRadius="10"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="28">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Text="PrintArchive" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock x:Name="Subtitle" Grid.Row="1" Margin="0,8,0,20"
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                 Text="Enter your archive password to unlock print history."/>

      <TextBlock x:Name="PasswordLabel" Grid.Row="2" Text="Password" Margin="0,0,0,6"
                 Foreground="{StaticResource MutedBrush}"/>
      <PasswordBox x:Name="PasswordInput" Grid.Row="3" Height="38"
                   VerticalContentAlignment="Center"/>

      <StackPanel x:Name="ConfirmPanel" Grid.Row="4" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock Text="Confirm password" Margin="0,0,0,6"
                   Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="ConfirmInput" Height="38" VerticalContentAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,24,0,0">
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="PrimaryButton" Content="Unlock" Style="{StaticResource PrimaryButton}"
                IsDefault="True" Click="Primary_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
