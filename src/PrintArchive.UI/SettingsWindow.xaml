<Window x:Class="PrintArchive.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintArchive Settings" Height="460" Width="500"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
    <Border Background="{StaticResource PanelBrush}" Margin="18" CornerRadius="12"
            BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1" Padding="24">
      <StackPanel>
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,18" Foreground="{StaticResource MutedBrush}"
                   Text="Storage quota and password management."/>

        <TextBlock Text="Archive storage limit (GB)" Margin="0,0,0,6"
                   Foreground="{StaticResource MutedBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBox x:Name="QuotaBox" Width="120" Height="36" VerticalContentAlignment="Center"/>
          <TextBlock x:Name="UsageLabel" Margin="14,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <TextBlock Text="Change password" Margin="0,18,0,10" FontWeight="SemiBold"/>
        <TextBlock Text="Current password" Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="CurrentPassword" Margin="0,0,0,10" Height="36"
                     VerticalContentAlignment="Center"/>
        <TextBlock Text="New password" Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="NewPassword" Margin="0,0,0,10" Height="36"
                     VerticalContentAlignment="Center"/>
        <TextBlock Text="Confirm new password" Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="ConfirmPassword" Height="36" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
          <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
