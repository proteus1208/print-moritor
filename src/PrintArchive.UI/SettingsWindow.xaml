<Window x:Class="PrintArchive.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintArchive Settings" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Border Background="{StaticResource PanelBrush}" Margin="18" CornerRadius="10"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="1" Margin="0,6,0,18" Foreground="{StaticResource MutedBrush}"
                 Text="Storage quota and password management."/>

      <TextBlock Grid.Row="2" Text="Archive storage limit (GB)" Margin="0,0,0,6"
                 Foreground="{StaticResource MutedBrush}"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal">
        <TextBox x:Name="QuotaBox" Width="120" Height="34" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="UsageLabel" Margin="14,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>

      <GroupBox Grid.Row="4" Header="Change password" Margin="0,22,0,0"
                Foreground="{StaticResource MutedBrush}" BorderBrush="{StaticResource BorderBrush}">
        <StackPanel Margin="10">
          <PasswordBox x:Name="CurrentPassword" Margin="0,0,0,8" Height="34"
                       ToolTip="Current password" VerticalContentAlignment="Center"/>
          <PasswordBox x:Name="NewPassword" Margin="0,0,0,8" Height="34"
                       ToolTip="New password" VerticalContentAlignment="Center"/>
          <PasswordBox x:Name="ConfirmPassword" Height="34"
                       ToolTip="Confirm new password" VerticalContentAlignment="Center"/>
        </StackPanel>
      </GroupBox>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
